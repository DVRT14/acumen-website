 "steps": [
  [
   "Step 1: Access data",
   "<p>We make data accessible, which is vital for every business, driving informed decisions and sustainable growth in a competitive market.</p>"
  ],
  [
   "Step 2: Integrate data",
   "<p>Integrating data is essential &#8211; it’s your business’s memory bank, safeguarding valuable insights and opportunities.</p>"
  ],
  [
   "Step 3: Model data",
   "<p>Modeling data is the secret to actionable insights and making informed choices</p>"
  ],
  [
   "Step 4: Analyse &amp; Visualize",
   "<p>Analyzing and visualizing data is like painting a picture of your business &#8211; it reveals patterns and insights that guide smarter decisions and spark innovation.</p>"
  ],
  [
   "Step 5: Predict &amp; Report",
   "<p>Data reporting paints a clear picture of your business journey, guiding decisions and fostering transparency with stakeholders.</p>"
  ]
 ],
