---
// Knowledge posts (src/content/knowledge/*.md): one layout per type. SEO + JSON-LD are built here from the
// frontmatter; the layout renders the page and the Markdown body in its default slot.
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/knowledge/CaseStudy.astro';
import Blog from '../../components/knowledge/Blog.astro';
import Whitepaper from '../../components/knowledge/Whitepaper.astro';
import { related, card, readingTime, TYPE_LABEL } from '../../lib/knowledge';

export async function getStaticPaths() {
  return (await getCollection('knowledge', p => !p.data.custom)).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const author = (await getEntry(d.author))!;
const { Content, headings } = await render(post);
const Layout = { case: CaseStudy, blog: Blog, whitepaper: Whitepaper }[d.type];

const seo = { title: d.seoTitle ?? `${d.title} | Acumen`, description: d.description, image: d.ogImage ?? d.image?.src, published: d.date, modified: d.updated, noindex: d.noindex, lang: d.lang };
const a = author.data;
const article = {
  type: d.type === 'blog' ? 'BlogPosting' : 'Article', headline: d.title, tags: d.tags, section: TYPE_LABEL[d.type],
  author: { name: a.name, org: a.org, url: a.org ? undefined : `/knowledge/authors/${author.id}/`, sameAs: a.linkedin, jobTitle: a.role },
} as const;
const schema = d.faq ? [{ '@type': 'FAQPage', mainEntity: d.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : [];
const props = { post, author, headings, related: (await related(post)).map(card), minutes: readingTime(post.body) };
---
<Base seo={seo} article={article} schema={schema}>
  <Layout {...props}><Content /></Layout>
</Base>
