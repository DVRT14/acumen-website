---
// Concept template for the expertise detail pages (noindex). Content: data/concept-expertise.ts; the expert portrait
// comes from the live content/expertise/<slug>.json. Storyline: hero (decision + the stack, this layer marked) →
// symptoms → why it matters for AI → the page's signature block → what we build / how we work / proof (order set by
// `shape`) → FAQ → CTA. Shared pieces: case.css (chips, CTA card), Faq.astro. Every optional field has a fallback.
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/knowledge/Faq.astro';
import { expertises } from '../../../data/concept-expertise';
import '../../../styles/case.css';

export function getStaticPaths() {
  const live = import.meta.glob('../../../content/expertise/*.json', { eager: true, import: 'default' }) as Record<string, any>;
  return expertises.map(x => ({ params: { slug: x.slug }, props: { x, live: live[`../../../content/expertise/${x.slug}.json`] } }));
}
const { x, live } = Astro.props;
// Stack labels name the image and say what it means, so a first-time reader doesn't need /our-expertise/ to decode it.
const roles = { house: 'The house: decisions and AI', foundation: 'The foundation: your data' } as const;
const seo = { ...x.seo, noindex: true };
const schema = [{ '@type': 'FAQPage', mainEntity: x.faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
const arrow = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';

const shape = x.shape ?? 'outcome';
const eyebrow = x.eyebrow ?? `${roles[x.group]} · ${x.page}`;
const depends = new Set(x.depends ?? []);
const button = x.cta.button ?? 'Plan a call';
// Published work only: anonymised items stay in the data until the client signs off, but are not shown.
// A card with a figure leads, so the featured slot shows it (sort is stable, data order otherwise kept).
const proof = x.proof.filter(p => p.href).sort((a, b) => Number(!!b.metric) - Number(!!a.metric));
const hasLinkedProof = proof.length > 0;
const kindLabel = { case: 'Customer case', article: 'Article', anon: 'Client work, anonymised' } as const;
const featured = proof.length <= 2;
const definesDI = /decision intelligence/i.test(`${x.why.title} ${x.why.text}`);
const sig = x.signature;
// phase (strategy) leads with the steps, since the steps are the product, and its scored table then illustrates
// them; service (support) is ongoing, so its steps are unnumbered and come after the proof; outcome pages run
// signature → build → how → proof.
const order = (shape === 'phase' ? ['how', 'sig', 'build', 'proof'] : shape === 'service' ? ['sig', 'build', 'proof', 'how'] : ['sig', 'build', 'how', 'proof'])
  .filter(k => (k !== 'proof' || hasLinkedProof) && (k !== 'sig' || sig));
// Phones collapse the stack to this page + what it relies on; a page that relies on nothing shows the whole stack.
const collapsible = depends.size > 0;

// Stack, top to bottom; d = step-in counted from the bottom, so the last foundation layer is the widest.
const groups = (['house', 'foundation'] as const).map(g => ({ g, role: roles[g], layers: expertises.filter(e => e.group === g) }));
let n = expertises.length;
const stack = groups.map(g => ({ ...g, layers: g.layers.map(e => ({ e, d: --n })) }));

// Smallest srcset variant at least 2 × the 56px avatar, so the CTA portrait doesn't pull a 1200px photo.
const avatar = (img: any) => {
  const c = String(img?.srcset ?? '').split(',').map(s => s.trim().split(/\s+/)).map(([u, w]) => ({ u, w: parseInt(w) }))
    .filter(v => v.u && v.w >= 112).sort((a, b) => a.w - b.w);
  return c[0]?.u ?? img?.src;
};
const avatarSrc = avatar(live?.contactImage);
---
<Base seo={seo} schema={schema}>
  <article class:list={['case', 'xc', `xc--${shape}`]}>
    <section class="case-wrap xc-hero">
      <div class="xc-hero__text">
        <a class="xc-back" href="/concept/expertise/"><span aria-hidden="true">←</span> All expertise concepts</a>
        <p class="xc-eyebrow">{eyebrow}</p>
        <h1 class="xc-title">{x.lead}</h1>
        <p class="xc-intro">{x.intro}</p>
        <div class="xc-actions">
          <a class="btn" href="/contact/">{button}</a>
          {hasLinkedProof && <a class="btn btn--outline" href="#proof">See it in practice</a>}
        </div>
      </div>

      <nav class="xc-stack" aria-label="Where this sits in the stack">
        {/* Before the layers in the DOM, so after opening, focus stays on the toggle and the next Tab reaches the revealed layers. */}
        {collapsible && <details class="xc-stack__all"><summary><span class="xc-all__closed">Show all {expertises.length} layers</span><span class="xc-all__open">Show fewer layers</span></summary></details>}
        {stack.map(g => (
          <div class="xc-stack__group">
            <p class="xc-stack__role">{g.role}</p>
            <ol class="xc-stack__list">
              {g.layers.map(({ e, d }) => {
                const here = e.slug === x.slug;
                const cls = ['xc-layer', `xc-layer--${e.group}`, { 'xc-layer--ai': e.ai, 'xc-layer--here': here, 'xc-layer--dep': depends.has(e.slug) }];
                // One line on purpose: whitespace between the spans would read as a stray space before the hidden comma.
                const inner = <><span class="xc-layer__page">{e.page}</span><span class="visually-hidden">: </span><span class="xc-layer__what">{e.layer}</span>{here && <span class="xc-tag"><span class="visually-hidden">, </span>This page</span>}{!here && depends.has(e.slug) && <span class="xc-tag"><span class="visually-hidden">, </span>Relies on</span>}</>;
                return (
                  <li style={`--d:${d}`} class:list={{ 'is-other': collapsible && !here && !depends.has(e.slug) }}>
                    {here ? <span class:list={cls} aria-current="page">{inner}</span> : <a class:list={cls} href={`/concept/expertise/${e.slug}/`}>{inner}</a>}
                  </li>
                );
              })}
            </ol>
          </div>
        ))}
      </nav>
    </section>

    <section class="case-wrap xc-sec xc-split" aria-labelledby="symptoms">
      <h2 class="xc-h2" id="symptoms">{x.symptoms.title}</h2>
      <ul class="xc-rules">
        {x.symptoms.items.map(s => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
      </ul>
    </section>

    <section class="xc-why" aria-labelledby="why">
      <div class="case-wrap xc-why__inner">
        <p class="xc-kicker">Why it matters for AI</p>
        <h2 class="xc-why__title" id="why">{x.why.title}</h2>
        <p class="xc-why__text">{x.why.text}</p>
        {!definesDI && <p class="xc-di"><strong>Decision intelligence:</strong> routine decisions run on data, your experts own the exceptions.</p>}
      </div>
    </section>

    {order.map(k => k === 'sig' ? (
      <section class:list={['case-wrap', 'xc-sec', 'xc-sig', `xc-sig--${sig!.kind}`]} aria-labelledby="sig-title">
        <header class="xc-head">
          <h2 class="xc-h2" id="sig-title">{sig!.title}</h2>
          {sig!.intro && <p>{sig!.intro}</p>}
        </header>

        {sig!.kind === 'split' && (
          <div class="xc-vs">
            {[sig!.a, sig!.b].filter(Boolean).map((col, i) => (
              <div class:list={['xc-vs__col', i ? 'xc-vs__col--b' : 'xc-vs__col--a']}>
                <p class="xc-vs__label">{col!.label}</p>
                <ul>{col!.items.map(t => <li>{t}</li>)}</ul>
              </div>
            ))}
          </div>
        )}

        {sig!.kind === 'rows' && sig!.rows && (
          <div class="xc-table-wrap">
            <table class="xc-table">
              <caption class="visually-hidden">{sig!.title}</caption>
              {sig!.head && <thead><tr>{sig!.head.map(h => <th scope="col">{h}</th>)}</tr></thead>}
              <tbody>
                {sig!.rows.map(r => (
                  <tr>
                    <th scope="row">{r.k}</th>
                    <td data-label={sig!.head?.[1]}>{r.v}</td>
                    {sig!.rows!.some(q => q.w) && <td data-label={sig!.head?.[2]}>{r.w}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {sig!.kind === 'flow' && sig!.steps && (
          <ol class="xc-flow" style={`--n:${sig!.steps.length}`}>
            {sig!.steps.map(s => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
          </ol>
        )}
      </section>
    ) : k === 'build' ? (
      <section class="case-wrap xc-sec" aria-labelledby="build">
        <header class="xc-head">
          <h2 class="xc-h2" id="build">{x.build.title}</h2>
          <p>{x.build.intro}</p>
        </header>
        <ul class="xc-build">
          {x.build.items.map(b => <li><h3>{b.t}</h3><p>{b.d}</p></li>)}
        </ul>
        {x.build.scope && <p class="xc-scope">{x.build.scope}</p>}
        {x.stack && (
          <div class="xc-tools">
            <p class="xc-meta">Tools we use</p>
            <ul class="case-chips">{x.stack.map(t => <li>{t}</li>)}</ul>
          </div>
        )}
      </section>
    ) : k === 'how' ? (
      <section class="case-wrap xc-sec xc-split" aria-labelledby="how">
        <h2 class="xc-h2" id="how">How we work</h2>
        {shape === 'service'
          ? <ul class="xc-steps xc-steps--plain">{x.steps.map(s => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}</ul>
          : <ol class="xc-steps">{x.steps.map(s => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}</ol>}
      </section>
    ) : (
      <section class="case-wrap xc-sec" id="proof" aria-labelledby="proof-title">
        <header class="xc-head"><h2 class="xc-h2" id="proof-title">In practice</h2></header>
        <ul class:list={['xc-proof', { 'xc-proof--featured': featured }]}>
          {proof.map((p, i) => {
            const kind = p.kind ?? (p.href ? 'case' : 'anon');
            const id = `proof-${i}`;
            const body = <>
              <p class="xc-card__meta"><span>{kindLabel[kind]}</span><span aria-hidden="true">·</span><span class="xc-card__client">{p.client}</span></p>
              {p.metric && <p class="xc-metric"><strong>{p.metric.value}</strong><span>{p.metric.label}</span></p>}
              {!p.metric && p.change && featured && i === 0 && (
                <dl class="xc-change"><div><dt>Before</dt><dd>{p.change.before}</dd></div><div><dt>After</dt><dd>{p.change.after}</dd></div></dl>
              )}
              <h3 class="xc-card__q" id={id}>{p.decision}</h3>
              <p class="xc-card__result">{p.result}</p>
              {p.tags && <ul class="case-chips">{p.tags.map(t => <li>{t}</li>)}</ul>}
              {p.href && <span class="xc-go" set:html={arrow} />}
            </>;
            return <li>{p.href
              ? <a class="xc-card xc-card--link" href={p.href} aria-labelledby={id}>{body}</a>
              : <div class="xc-card">{body}</div>}</li>;
          })}
        </ul>
      </section>
    ))}

    <div class="case-wrap"><Faq items={x.faq} /></div>

    <section class="case-wrap case-cta" aria-labelledby="cta-title">
      <div class="case-cta__card">
        <h2 class="case-cta__title" id="cta-title" set:html={x.cta.title} />
        <p class="case-cta__text">{x.cta.text}</p>
        {x.expert && avatarSrc && <p class="xc-expert"><img src={avatarSrc} alt="" width="56" height="56" loading="lazy" decoding="async" />With {x.expert}</p>}
        <a class="case-cta__button" href="/contact/">{button}</a>
      </div>
    </section>
  </article>
</Base>

<style>
  .xc { padding-bottom: 40px; }

  /* Hero: the decision on the left, the stack on the right with this layer marked */
  .xc-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 470px); gap: 40px 72px; align-items: center; padding-top: 36px; padding-bottom: 40px; }
  .xc-hero__text { display: flex; flex-direction: column; align-items: flex-start; }
  .xc-back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 15px; color: var(--label); text-decoration: none; }
  .xc-back:hover { color: var(--green); text-decoration: underline; text-underline-offset: 4px; }
  .xc-eyebrow { max-width: 100%; margin: 28px 0 22px; padding: 6px 16px; border-radius: 16px; background: var(--lime); font-size: 16px; font-weight: 500; line-height: 1.35; text-wrap: balance; }
  .xc-title { margin: 0; max-width: 15em; font-family: var(--display); font-size: 58px; font-weight: 400; line-height: 1.05; letter-spacing: -0.04em; text-wrap: balance; hyphens: manual; overflow-wrap: normal; }
  .xc-intro { margin: 26px 0 0; max-width: 38em; font-size: 20px; line-height: 1.55; color: var(--text-soft); }
  .xc-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

  .xc-stack { display: flex; flex-direction: column; gap: 14px; }
  .xc-stack__role { margin: 0 0 8px; font-size: 13px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--label); }
  .xc-stack__list { display: flex; flex-direction: column; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .xc-stack__list li { margin-left: calc(var(--d) * 14px); }
  .xc-layer { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0 12px; align-items: center; padding: 10px 14px 10px 18px; border-radius: 10px; background: var(--grey); color: var(--green); text-decoration: none; transition: box-shadow .25s, background-color .25s; }
  .xc-layer__page { font-family: var(--display); font-size: 18px; line-height: 1.2; letter-spacing: -0.02em; }
  .xc-layer__what { grid-column: 1; font-size: 13px; line-height: 1.35; color: var(--text-soft); }
  .xc-layer--house { background: var(--green); color: var(--white); }
  .xc-layer--house .xc-layer__what { color: var(--on-dark-muted); }
  .xc-layer--ai { background: var(--lime); color: var(--green); }
  .xc-layer--ai .xc-layer__what { color: var(--green); }
  .xc-tag { grid-column: 2; grid-row: 1 / span 2; padding: 3px 10px; border: 1px solid currentColor; border-radius: 100px; font-size: 12px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; }
  .xc-layer--house:not(.xc-layer--ai):not(.xc-layer--here) .xc-tag { color: var(--lime); }
  /* This page: larger, ringed and tagged; the rest of the stack recedes a little so it reads as context */
  .xc-layer--here { padding-top: 16px; padding-bottom: 16px; box-shadow: 0 0 0 3px var(--white), 0 0 0 5px var(--green); }
  .xc-layer--here .xc-layer__page { font-size: 24px; }
  .xc-layer--here .xc-tag { border-color: transparent; background: var(--white); color: var(--green); }
  .xc-layer--ai.xc-layer--here .xc-tag, .xc-layer--foundation.xc-layer--here .xc-tag { background: var(--green); color: var(--lime); }
  .xc-layer--dep:not(.xc-layer--house) { box-shadow: inset 0 0 0 1px var(--green); }
  @media (hover: hover) {
    a.xc-layer:hover { box-shadow: inset 0 0 0 2px var(--green); }
    a.xc-layer--house:hover { background: color-mix(in srgb, var(--green) 86%, var(--white)); box-shadow: none; }
    a.xc-layer--ai:hover { background: var(--lime); box-shadow: inset 0 0 0 2px var(--green); }
    a.xc-layer:hover .xc-layer__page { text-decoration: underline; text-underline-offset: 4px; }
  }

  .xc-sec { padding-top: 110px; }
  .xc-split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 30px 80px; align-items: start; }
  .xc-h2 { margin: 0; font-family: var(--display); font-size: 52px; font-weight: 400; line-height: 1.06; letter-spacing: -0.04em; text-wrap: balance; }
  .xc-head { max-width: 760px; margin-bottom: 48px; }
  .xc-head p { margin: 16px 0 0; color: var(--text-soft); }
  .xc-meta { margin: 0; font-size: 13px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--label); }
  .xc h3 { margin: 0; font-family: var(--display); font-size: 26px; font-weight: 400; line-height: 1.2; letter-spacing: -0.03em; }
  .xc li p { margin: 8px 0 0; font-size: 18px; line-height: 1.5; color: var(--text-soft); }

  /* Symptoms: ruled list */
  .xc-rules { margin: 0; padding: 0; list-style: none; }
  .xc-rules li { padding: 26px 0 28px; border-top: 1px solid var(--line); }
  .xc-rules li:last-child { border-bottom: 1px solid var(--line); }

  /* Why: the one dark band, the page's thesis */
  .xc-why { margin-top: 110px; background: var(--green); color: var(--white); }
  .xc-why__inner { padding-top: 100px; padding-bottom: 100px; }
  .xc-kicker { margin: 0 0 20px; font-size: 14px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; color: var(--lime); }
  .xc-why__title { margin: 0; max-width: 18em; font-family: var(--display); font-size: 56px; font-weight: 400; line-height: 1.08; letter-spacing: -0.04em; text-wrap: balance; }
  .xc-why__text { margin: 28px 0 0; max-width: 34em; font-size: 20px; line-height: 1.55; color: var(--on-dark-muted); }
  .xc-di { margin: 28px 0 0; max-width: 34em; padding-top: 24px; border-top: 1px solid var(--line-on-dark); font-size: 18px; line-height: 1.5; color: var(--white); }
  .xc-di strong { font-weight: 500; color: var(--lime); }

  /* Signature: the page's one authored block */
  .xc-vs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid var(--green); border-radius: 28px; overflow: hidden; }
  .xc-vs__col { padding: 44px 44px 48px; }
  .xc-vs__col--b { background: var(--green); color: var(--white); }
  .xc-vs__label { margin: 0 0 24px; font-family: var(--display); font-size: 30px; line-height: 1.15; letter-spacing: -0.03em; }
  .xc-vs__col--b .xc-vs__label { color: var(--lime); }
  .xc-vs ul { margin: 0; padding: 0; list-style: none; }
  .xc-vs li { padding: 14px 0; border-top: 1px solid var(--line); font-size: 18px; line-height: 1.45; }
  .xc-vs__col--a li { color: var(--text-soft); }
  .xc-vs__col--b li { border-top-color: var(--line-on-dark); font-weight: 400; }

  .xc-table-wrap { overflow-x: auto; }
  .xc-table { width: 100%; margin: 0; border-collapse: collapse; font-size: 18px; line-height: 1.45; }
  /* reset the global table skin (cell borders, zebra rows, hover tint) */
  .xc-table th, .xc-table td { border: 0; background: transparent; }
  .xc-table thead th { padding: 0 24px 14px 0; border-bottom: 2px solid var(--green); font-size: 13px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; text-align: left; color: var(--label); }
  .xc-table tbody th, .xc-table td { padding: 22px 24px 22px 0; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .xc-table tbody th { width: 30%; font-family: var(--display); font-size: 24px; font-weight: 400; line-height: 1.2; letter-spacing: -0.02em; }
  .xc-table td { color: var(--text-soft); }

  .xc-flow { position: relative; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 28px; margin: 0; padding: 0; list-style: none; }
  /* From the first dot's centre to the last dot's centre: one column width minus half a dot from the right. */
  .xc-flow::before { content: ''; position: absolute; top: 9px; left: 10px; right: calc((100% - (var(--n) - 1) * 28px) / var(--n) - 10px); height: 2px; background: var(--green); }
  .xc-flow li { position: relative; padding-top: 44px; }
  .xc-flow li::before { content: ''; position: absolute; top: 0; left: 0; width: 20px; height: 20px; border: 2px solid var(--green); border-radius: 50%; background: var(--lime); box-sizing: border-box; }
  .xc-flow h3 { font-size: 24px; }

  /* What we build: a ruled two-column grid, no counters (the order carries no meaning) */
  .xc-build { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 64px; margin: 0; padding: 0; list-style: none; }
  .xc-build li { padding: 28px 0 32px; border-top: 2px solid var(--green); }
  .xc-scope { margin: 28px 0 0; max-width: 46em; font-size: 18px; font-style: italic; color: var(--text-soft); }
  .xc-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 36px; }
  .xc-tools .case-chips { margin: 0; }

  /* How we work: numbered steps (unnumbered for the ongoing service) */
  .xc-steps { margin: 0; padding: 0; list-style: none; counter-reset: s; }
  .xc-steps li { counter-increment: s; display: grid; grid-template-columns: 64px minmax(0, 1fr); padding: 24px 0; border-top: 1px solid var(--line); }
  .xc-steps li::before { content: counter(s); grid-row: span 2; font-family: var(--display); font-size: 44px; line-height: 1; letter-spacing: -0.04em; color: var(--green); }
  .xc-steps li p { grid-column: 2; }
  .xc-steps--plain li { grid-template-columns: minmax(0, 1fr); }
  .xc-steps--plain li::before { content: none; }
  .xc-steps--plain li p { grid-column: 1; }
  /* phase: the steps are the product, so they lead and get the larger type */
  .xc--phase .xc-steps h3 { font-size: 32px; }

  /* Proof: one card language; linked cards add the arrow and a hover ring */
  .xc-proof { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .xc-proof > li { display: flex; }
  .xc-card { position: relative; display: flex; flex-direction: column; gap: 12px; width: 100%; padding: 30px 30px 32px; border-radius: 24px; background: var(--grey); color: var(--green); text-decoration: none; transition: box-shadow .25s; }
  .xc .xc-card p { margin: 0; }
  .xc-card__meta { display: flex; flex-wrap: wrap; gap: 0 .5em; padding-right: 52px; font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--label); }
  .xc-card__client { color: var(--green); }
  .xc .xc-card__q { font-size: 26px; line-height: 1.22; text-wrap: pretty; }
  .xc .xc-card__result { font-size: 17px; line-height: 1.5; color: var(--text-soft); }
  .xc-metric { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 14px; }
  .xc-metric strong { font-family: var(--display); font-size: 48px; font-weight: 400; line-height: 1; letter-spacing: -0.04em; }
  .xc-metric span { font-size: 16px; color: var(--text-soft); }
  .xc-card .case-chips { margin-top: auto; padding-top: 10px; }
  .xc-go { position: absolute; top: 24px; right: 24px; display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid currentColor; border-radius: 50%; transition: background-color .25s, color .25s; }
