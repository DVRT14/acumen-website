---
// "Related posts" carousel (was an Elementor loop carousel). elementor.js initialises Swiper with the
// same settings JSON the old widget carried.
import 'swiper/css/bundle';
import PostCard from './PostCard.astro';
import cards from '../../data/cards.json';

interface Props { ids: string[]; info?: 'date' | 'terms'; animate?: boolean }
const { ids, info, animate = true } = Astro.props;
const settings = {
  slides_to_show: '2', slides_to_show_tablet: '2', slides_to_show_mobile: '1', slides_to_scroll: '1',
  offset_sides: 'right', offset_width: { unit: 'px', size: 50, sizes: [] }, offset_width_mobile: { unit: 'px', size: 30, sizes: [] },
  image_spacing_custom: { unit: 'px', size: 25, sizes: [] }, image_spacing_custom_mobile: { unit: 'px', size: 15, sizes: [] },
  infinite: 'yes', speed: 500,
};
---
<div class="posts-carousel animated-fast" data-animate={animate ? 'fadeIn' : undefined} data-animate-delay={animate ? '500' : undefined} data-carousel={JSON.stringify(settings)}>
  <div class="swiper posts-carousel__swiper">
    <div class="swiper-wrapper">
      {ids.map((id, i) => cards[id] && (
        <div class="swiper-slide posts-carousel__slide" role="group" aria-roledescription="slide"><PostCard card={cards[id]} info={info} /></div>
      ))}
    </div>
  </div>
</div>
