---
// Visible FAQ (the FAQPage JSON-LD is built from the same frontmatter in pages/knowledge/[slug].astro).
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
<section class="faq" aria-labelledby="faq-title">
  <h2 id="faq-title" class="faq__title">{title}</h2>
  {items.map(f => (
    <details class="faq__item">
      <summary class="faq__q"><h3>{f.q}</h3></summary>
      <p class="faq__a">{f.a}</p>
    </details>
  ))}
</section>

<style>
  .faq { margin-top: 64px; }
  .faq__title { margin: 0 0 24px; font: 400 clamp(28px, 3vw, 40px)/1.1 "Atype Display", sans-serif; letter-spacing: -0.04em; color: #002921; }
  .faq__item { border-top: 1px solid #D5DEDC; }
  .faq__item:last-child { border-bottom: 1px solid #D5DEDC; }
  .faq__q { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; cursor: pointer; list-style: none; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q::after { content: '+'; flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%; background: #F4F4F4; font: 300 22px/32px "DM Sans", sans-serif; text-align: center; color: #002921; transition: transform .2s; }
  .faq__item[open] > .faq__q::after { transform: rotate(45deg); background: #C8EF00; }
  .faq__q:focus-visible { outline: 2px solid #002921; outline-offset: 4px; }
  .faq__q h3 { margin: 0; font: 400 20px/1.3 "DM Sans", sans-serif; color: #002921; }
  .faq__a { margin: 0 0 24px; max-width: 65ch; font-size: 17px; font-weight: 300; line-height: 1.7; color: #002921; }
  @media (max-width: 767px) { .faq__q h3 { font-size: 17px; } .faq__a { font-size: 16px; } }
</style>
