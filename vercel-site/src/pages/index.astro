---
// Home: built around the "information need / decision intelligence" story. Visual system: case.css
// (shared with the case/blog layouts) + home-hero.css (hero, photo, tools) + concept.css.
import Base from '../layouts/Base.astro';
import meta from '../data/meta.json';
import home from '../content/one-off/index.json';
import { posts, href } from '../lib/knowledge';
import '../styles/case.css';
import '../styles/home-hero.css';
import '../styles/concept.css';

// Lead case first: it is walked through the four steps; the others show decision + result.
const featured = ['routing-optimization-essers-acumen', 'kaneka-powerbi-sap-datasphere', 'ai-legal-assistant-animo-law', 'bionerga-future-ready-data-platform'];
const cases = (await posts('case')).filter(p => featured.includes(p.id)).sort((a, b) => featured.indexOf(a.id) - featured.indexOf(b.id));
const [lead, ...others] = cases;
// Walk-through of the lead case (H.Essers). Decision and result come from `outcome`; the middle two steps
// paraphrase the case's own excerpt, title and technologies. Nothing here goes beyond that frontmatter.
const leadSteps = [
  ['The decision', lead.data.outcome?.decision],
  ['The information need', 'How large volumes of real orders play out across multiple routing scenarios, and where the efficiency gains are.'],
  ['A trusted foundation', 'A simulation engine on Databricks and Apache Spark, built in Python.'],
  ['AI in the process', `Route optimisation with Google OR-Tools. ${lead.data.outcome?.result ?? ''}`],
];
const leadImg = { ...lead.data.image, alt: '', loading: 'lazy', decoding: 'async', sizes: '(max-width: 1024px) calc(100vw - 32px), 460px' };
// Hero: the original home hero (green block with typed word, photo that widens while its text lights up), new message.
const arrow = '<svg xmlns="http://www.w3.org/2000/svg" width="46.819" height="46.819" viewBox="0 0 46.819 46.819"><path d="M5.838,24.92l19.7,19.7-2.127,2.2L0,23.409,23.409,0l2.128,2.2L5.838,21.9H46.819V24.92Z" transform="translate(46.819 46.819) rotate(180)"></path></svg>';
const mouseTrack = JSON.stringify({ motion_fx_motion_fx_mouse: 'yes', motion_fx_mouseTrack_effect: 'yes', motion_fx_mouseTrack_speed: { unit: 'px', size: 0.1, sizes: [] } });
const typed = ['better decisions', 'faster answers', 'trusted insight', 'smarter processes'];
const team = { ...home.teamImage, alt: 'Acumen colleagues at the office', loading: 'lazy', sizes: '(max-width: 1024px) calc(100vw - 32px), 460px' };

const pains = [
  ['The report arrives after the decision', 'A traditional reporting cycle takes one to two weeks. By the time the numbers are ready, the moment to act has often passed.'],
  ['New questions go unanswered', 'Dashboards answer the questions someone anticipated. Every new question ends up on an analyst’s to-do list.'],
  ['AI pilots stall without context', 'A demo impresses. Production needs trusted data, shared definitions and governance underneath, and that is what most pilots lack.'],
];
const steps = [
  ['The decision', 'Which objectives and decisions matter most? Who makes them, and how often?'],
  ['The information need', 'What does that person need to know, when, and how reliable does it have to be?'],
  ['A trusted foundation', 'A data platform with governance and reporting built in, carrying the context AI depends on: definitions, lineage and ownership.'],
  ['AI in the process', 'Models and agents that act on that foundation, with people in control of the decisions that matter.'],
];
const doors = [
  {
    step: 'From step 3', title: 'Build a data foundation you can trust',
    text: 'Modern data platforms on Databricks or Microsoft Fabric, transformed with dbt and orchestrated with Dagster. Governance, reporting and planning are built in, not bolted on.',
    links: [['Connect and prepare your data', '/expertise/dataintegration-engineering/'], ['Agree on data quality and ownership', '/expertise/data-governance/'], ['Build reports and dashboards', '/expertise/datavisualisation-reporting/'], ['Plan budgets and forecasts', '/expertise/data-planning-epm/']],
  },
  {
    step: 'From step 4', title: 'Put AI to work in your processes',
    text: 'From machine learning and optimisation to agentic AI that reads documents, prepares quotes and handles requests, always within a strategy agreed up front.',
    links: [['Apply machine learning and AI', '/expertise/datascience-ai/'], ['Set a data and AI strategy', '/expertise/data-strategy/'], ['What agentic AI can do for you', '/knowledge/agentic-ai/']],
  },
];
const reasons = [
  ['The same team, start to finish.', 'The experts who design your solution also build it.'],
  ['Pragmatic by default.', 'We scope to the decision that matters, prove it on real data, then scale.'],
  ['Since 2007.', 'Data work in Leuven, from reporting to AI, as part of the collecd data collective.'],
];
const next = [
  ['You talk to a senior consultant,', 'someone who designs and builds, not a salesperson.'],
  ['Free and without obligation.', 'A conversation about your decision, not a sales pitch.'],
  ['You leave with a clear first step:', 'what information the decision needs and where to start.'],
];
---
<Base {...meta.index}>
  <div class="case cx">
    <div class="hm">
      <section class="hm-hero greenSection">
        <div class="hm-hero__box">
          <div class="hm-hero__typed typedContainer delay">
            <div class="hm-hero__strings"><div class="typed-strings">{typed.map(s => <p>{s}</p>)}</div></div>
            <div class="hm-hero__title heroAnim1"><h1><span class="visually-hidden">Turn data into better decisions</span><span class="cx-h1" aria-hidden="true">Turn data into <br /><span class="typed">{typed[0]}</span></span></h1></div>
          </div>
          <div class="hm-hero__text heroAnim2"><div>Your data &amp; AI consultancy partner. We start from your processes, transforming data into decisions.</div></div>
          <div class="hm-btn hm-btn--ghost heroAnim3"><a href="/contact/"><span><span class="hm-btn__icon" set:html={arrow} /><span>Plan a free consultation</span></span></a></div>
        </div>
      </section>

      <section class="hm-photo parent">
        <div class="hm-photo__frame expand-section heroAnim4">
          <div class="hm-photo__img bgImage"><img {...home.photo} /></div>
          <div class="hm-photo__content"><div class="hm-photo__text textAnim">From trusted data foundations to AI that works inside your processes: we make sure the right information is there when the decision is made.</div></div>
        </div>
      </section>
    </div>

    <section class="cx-logos" aria-labelledby="cx-logos-title">
      <div class="case-wrap cx-logos__inner">
        <h2 class="cx-logos__title" id="cx-logos-title">Some of the organisations we work with</h2>
        <div class="cx-logos__track marqueee" wb-data="marquee" duration="40" direction="left">
          <div class="cx-logos__row marquee-content">
            {home.logos.map(img => <div class="cx-logos__logo"><img {...img} /></div>)}
          </div>
        </div>
      </div>
    </section>

    <section class="case-wrap cx-need" aria-labelledby="cx-need-title">
      <h2 class="cx-h2" id="cx-need-title">Every decision starts with a question. Too often, the answer comes too late.</h2>
      <ul class="cx-pains">
        {pains.map(([t, x]) => <li class="cx-pain"><h3>{t}</h3><p>{x}</p></li>)}
      </ul>
    </section>

    <section class="cx-approach" aria-labelledby="cx-approach-title">
      <div class="case-wrap cx-approach__inner">
        <div class="cx-head">
          <h2 class="cx-h2" id="cx-approach-title">We start from the decision, not from the tool.</h2>
          <p class="cx-head__text">Tools come last. We pick the right one for the problem, not the other way around.</p>
        </div>
        <ol class="cx-steps">
          {steps.map(([t, x]) => <li class="cx-step"><h3>{t}</h3><p>{x}</p></li>)}
        </ol>

        <div class="cx-flow">
          <div class="cx-flow__head">
            <h3 class="cx-flow__title">Two ways to get there.</h3>
            <p class="cx-flow__text">Not sure where to start? If you can’t trust your data yet, start with the foundation. If you can, put AI to work.</p>
          </div>
          {doors.map(d => (
            <article class="cx-door">
              <p class="cx-door__step">{d.step}</p>
              <h4 class="cx-door__title">{d.title}</h4>
              <p class="cx-door__text">{d.text}</p>
              <ul class="cx-door__links">{d.links.map(([l, h]) => <li><a href={h}>{l.replace(/ \S+$/, '')} <span class="cx-nowrap">{l.split(' ').pop()}&nbsp;<span aria-hidden="true">→</span></span></a></li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="case-wrap cx-proof" id="cases" aria-labelledby="cx-proof-title">
      <div class="cx-proof__head">
        <h2 class="cx-proof__title" id="cx-proof-title">Decisions we helped make better.</h2>
        <p class="cx-head__text">Four clients, the decision in front of them, and what changed.</p>
      </div>

      <article class="cx-lead" aria-labelledby="cx-lead-title">
        <div class="cx-lead__media"><img {...leadImg} /></div>
        <div class="cx-lead__body">
          <p class="cx-meta">{lead.data.client} · {lead.data.industry}</p>
          <dl class="cx-lead__steps">
            <div><dt>{leadSteps[0][0]}</dt><dd><h3 class="cx-lead__title" id="cx-lead-title">{leadSteps[0][1] ?? lead.data.title}</h3></dd></div>
            {leadSteps.slice(1).map(([t, x]) => <div><dt>{t}</dt><dd>{x}</dd></div>)}
          </dl>
          <a class="btn" href={href(lead)}>Read the {lead.data.client} case</a>
        </div>
      </article>

      <ul class="cx-cases">
        {others.map(p => (
          <li>
            <a class="cx-case" href={href(p)}>
              <span class="cx-meta">{p.data.client} · {p.data.industry}</span>
              <span class="cx-case__decision">{p.data.outcome?.decision ?? p.data.title}</span>
              {p.data.outcome?.result && <span class="cx-case__result">{p.data.outcome.result}</span>}
              <span class="cx-case__cta">Read the case <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
      <a class="cx-more" href="/knowledge/">See all customer cases <span aria-hidden="true">→</span></a>
    </section>

    <div class="hm">
      <section class="hm-box hm-tools">
        <div class="hm-box__in">
          <div class="hm-tools__row">
            <div class="hm-tools__card">
              <div class="hm-tools__head">
                <div class="hm-tools__title"><h2 set:html={home.toolsTitle} /></div>
                <div class="hm-tools__text" set:html={home.toolsText} />
                <a class="hm-tools__link" href={home.toolsLink.href}>{home.toolsLink.label}<span class="hm-btn__icon" set:html={arrow} /></a>
              </div>
              <div class="hm-tools__img">
                <div data-motion={mouseTrack}>
                  <ul class="hm-tools__logos" role="list">
                    {home.tools.map(({ size, ...img }) => <li class={`hm-tools__logo hm-tools__logo--${size}`}><img {...img} loading="lazy" decoding="async" /></li>)}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <section class="case-wrap cx-team" aria-labelledby="cx-team-title">
      <div class="cx-team__media"><img {...team} decoding="async" /></div>
      <div class="cx-team__text">
        <h2 class="cx-h2" id="cx-team-title">A boutique team that designs and builds.</h2>
        <p class="cx-team__lead">Trust and ownership drive how we work. Every team member owns their work, and together we make a real impact with data.</p>
        <ul class="cx-reasons">
          {reasons.map(([t, x]) => <li><strong>{t}</strong> {x}</li>)}
        </ul>
        <a class="btn btn--outline" href="/culture/">Our culture</a>
      </div>
    </section>

    <section class="case-wrap case-cta cx-cta" aria-labelledby="cx-cta-title">
      <div class="case-cta__card">
        <h2 class="case-cta__title" id="cx-cta-title">Make better decisions, faster.</h2>
        <p class="case-cta__text">Tell us which decision matters most. We’ll map the information, data and first step it needs.</p>
        <div class="cx-actions">
          <a class="btn btn--on-dark" href="/contact/">Plan a free consultation</a>
          <a class="btn btn--outline-on-dark" href="/our-expertise/">Explore our expertise</a>
        </div>
        <div class="cx-next">
          <h3 class="cx-next__title">What happens next</h3>
          <ol class="cx-next__list">
            {next.map(([t, x]) => <li><strong>{t}</strong> {x}</li>)}
          </ol>
        </div>
      </div>
    </section>

  </div>
</Base>
