---
// Our Expertise: the overview that routes to the /expertise/* pages. Decision intelligence rests on two expertises:
// Data Engineering (the foundation: one place for data and the context AI needs) and Data Science & AI (the house on top).
// A short story section first explains why, ending in what decision intelligence means here.
// The other disciplines are embedded in the two expertises, so they are listed under them as smaller links.
import Base from '../layouts/Base.astro';
import meta from '../data/meta.json';
import '../styles/post.css';
import '../styles/case.css';
const m = meta['our-expertise'];

const arrow = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';

// Too slow → fast but meaningless → fast and meaningful.
const steps = [
  { title: 'Too slow', text: 'Traditional reporting took one to two weeks from data to report. By the time the numbers arrived, the moment to decide had often passed.' },
  { title: 'Fast, without meaning', text: 'Self-service made data quick to reach, but nobody agreed on what the numbers meant. Speed turned into a question of trust.' },
  { title: 'Fast and meaningful', text: 'AI can now answer questions and take routine decisions directly. That only works when the data carries its context: what each number means, where it comes from and who owns it.' },
];

// role: the metaphor word that opens the intro. The main card's title is the detail page it opens; lead says what we do there.
const groups = [
  {
    id: 'data-engineering', role: 'The foundation.', title: 'Data Engineering',
    text: 'Ask an AI about data without context and you get confident, wrong answers. So we start underneath: all your data in one place, with its context built in. Definitions, tests, ownership and lineage live in the code next to the data, so they stay in step with it.',
    main: { href: '/expertise/dataintegration-engineering/', title: 'Data Integration & Engineering', lead: 'How we build your data platform', text: 'pipelines that bring data from every source into one platform, cleaned, tested and documented. Standard stack: dbt, Databricks or Microsoft Fabric, Dagster.' },
    embedded: [
      { href: '/expertise/data-governance/', title: 'Data Governance', text: 'Makes every answer checkable: agreed definitions and quality tests, built into the platform.' },
      { href: '/expertise/datavisualisation-reporting/', title: 'Data Visualization & Reporting', text: 'Dashboards and reports that put the right numbers in front of the people who decide.' },
      { href: '/expertise/support-maintenance/', title: 'Support & Maintenance', text: 'Keeps the foundation reliable as your business changes.' },
    ],
  },
  {
    id: 'data-science-ai', role: 'The house.', title: 'Data Science & AI',
    text: 'On that foundation we put AI to work in the operational decisions made every day: predicting no-shows, planning routes, forecasting demand, scheduling staff.',
    main: { href: '/expertise/datascience-ai/', title: 'Data Science & AI', lead: 'How we take AI to production', text: 'we choose the decisions worth automating, prove the model on your data and build it into the process.' },
    embedded: [
      { href: '/expertise/data-strategy/', title: 'Data Strategy', text: 'Picks which decisions the house is built for, and what they need.' },
      { href: '/expertise/data-planning-epm/', title: 'Data Planning & EPM', text: 'Enterprise performance management: turns strategy into plans, budgets and forecasts.' },
    ],
  },
];
---
<Base {...m}>
  <section class="post-sec post-hero">
    <div class="post-sec__inner post-hero__inner">
      <div class="post-hero__title oxp-title"><h1>Our expertise</h1></div>
      <p class="oxp-lead">Every decision starts with a question. Too often, the answer comes too late, or nobody trusts it. We are experts in decision intelligence: making your processes data- and AI-driven, so the right answer is there when the decision is made.</p>
      <nav class="oxp-nav" aria-label="Expertises">
        {groups.map(g => <a href={`#${g.id}`}>{g.title}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></a>)}
      </nav>
    </div>
  </section>

  <section class="oxp oxp--story" aria-labelledby="oxp-story-title">
    <div class="oxp__inner oxp__inner--story">
      <header class="oxp__head">
        <h2 id="oxp-story-title">Two attempts, one lesson</h2>
        <p>Since 2007 we have helped companies make informed decisions, and watched the market try twice to get answers faster. A report can stay wrong for years; a model built on the wrong meaning fails within weeks. Our operational AI work showed us what was missing.</p>
      </header>
      <ol class="oxp-steps">
        {steps.map((s, i) => (
          <li class:list={['oxp-step', { 'oxp-step--now': i === steps.length - 1 }]}>
            <span class="oxp-step__n" aria-hidden="true">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="oxp-di"><strong>That is decision intelligence.</strong> Routine decisions run on data automatically, and your experts own the exceptions, where their knowledge matters most. We build it in that order: the foundation first, then the house on top.</p>
    </div>
  </section>

  {groups.map(g => (
    <section class="oxp" id={g.id} aria-labelledby={`${g.id}-title`}>
      <div class="oxp__inner">
        <header class="oxp__head">
          <h2 id={`${g.id}-title`}>{g.title}</h2>
          <p><strong>{g.role}</strong> {g.text}</p>
        </header>
        <div class="oxp__body">
          <a class="oxp-main" href={g.main.href} aria-labelledby={`${g.id}-main`} aria-describedby={`${g.id}-main-text`}>
            <h3 class="oxp-main__title" id={`${g.id}-main`}>{g.main.title}</h3>
            <span class="oxp-main__text" id={`${g.id}-main-text`}><span class="oxp-main__page">{g.main.lead}:</span> {g.main.text}</span>
            <span class="oxp-go" aria-hidden="true" set:html={arrow} />
          </a>
          <p class="oxp__sub">Part of this expertise</p>
          <ul class="oxp__list">
            {g.embedded.map(it => (
              <li>
                <a class="oxp-link" href={it.href}>
                  <span class="oxp-link__title">{it.title}</span>
                  <span class="oxp-link__text">{it.text}</span>
                  <span class="oxp-go" aria-hidden="true" set:html={arrow} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section class="case-wrap case-cta oxp-cta" aria-labelledby="oxp-cta-title">
    <div class="case-cta__card">
      <h2 class="case-cta__title" id="oxp-cta-title">Which decision <span class="oxp-cta__hl">matters most?</span></h2>
      <p class="case-cta__text">If you can’t trust your data yet, start with the foundation. If you can, put AI to work. Tell us the decision and we’ll map the information it needs and the first step.</p>
      <a class="case-cta__button" href="/contact/">Get in touch</a>
    </div>
  </section>
</Base>

<style>
  .oxp-title { margin-bottom: 30px; }
  .oxp-lead { margin: 0 0 32px; max-width: 800px; font-family: var(--display); font-size: 30px; line-height: 1.35; color: var(--text-soft); }
  /* Jump links: outlined pills with a down arrow, so they read as "go to section". */
  .oxp-nav { display: flex; flex-wrap: wrap; gap: 10px; }
  .oxp-nav a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 18px 8px 22px; border: 1px solid var(--green); border-radius: 200px; font-size: 17px; line-height: 1.2; color: var(--green); text-decoration: none; transition: background-color .25s, color .25s; }
  .oxp-nav a:focus-visible { background: var(--green); color: var(--white); }
  .oxp-nav svg { transition: transform .3s cubic-bezier(.16, 1, .3, 1); }

  /* One section: intro left (sticky on desktop), content right. scroll-margin clears the fixed header (96px). */
  .oxp { padding: 70px 50px 0; scroll-margin-top: 100px; }
  .oxp--story { padding-top: 10px; }
  /* Layer name (The foundation. / The house.) carries the same lime underline as the decision intelligence line. */
  .oxp__head strong { font-weight: 500; color: var(--green); background: linear-gradient(transparent 62%, var(--lime) 62%); }
  .oxp__inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 30px 60px; max-width: 1180px; margin: 0 auto; padding-top: 30px; border-top: 1px solid var(--line); }
  .oxp__head { align-self: start; position: sticky; top: 120px; }
  .oxp__head h2 { margin: 0 0 20px; font-family: var(--display); font-size: 56px; font-weight: 400; line-height: 1.05; letter-spacing: -0.04em; color: var(--green); }
  .oxp__head p:last-child { margin: 0; max-width: 46ch; font-size: 20px; font-weight: 300; line-height: 1.45; color: var(--text-soft); }
  .oxp__sub { margin: 36px 0 14px; font-size: 14px; letter-spacing: .69px; text-transform: uppercase; color: var(--label); }

  /* Story: three steps as a hairline list, so grey rounded cards stay reserved for links. The last one (now) is marked by a green rule and darker text.
     Then the decision intelligence line across the full width. */
  .oxp__inner--story { row-gap: 50px; }
  /* Not sticky here: .oxp-di spans the full width below and would scroll under the pinned intro. */
  .oxp__inner--story .oxp__head { position: static; }
  .oxp-steps { margin: 0; padding: 0; border-bottom: 1px solid var(--line); list-style: none; }
  .oxp-step { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 6px 20px; padding: 26px 0; border-top: 1px solid var(--line); color: var(--green); }
  .oxp-step__n { grid-row: 1 / span 2; padding-top: 8px; font-size: 14px; letter-spacing: .69px; color: var(--label); }
  .oxp-step h3 { margin: 0; font-family: var(--display); font-size: 28px; font-weight: 400; line-height: 1.15; letter-spacing: -0.02em; color: inherit; }
  .oxp-step p { margin: 0; font-size: 17px; font-weight: 300; line-height: 1.45; color: var(--text-soft); }
  .oxp-step:first-child { padding-top: 0; border-top: 0; } /* the section rule above already opens the list */
  .oxp-step--now { border-top: 2px solid var(--green); }
  .oxp-step--now :is(.oxp-step__n, p) { color: var(--green); }
  .oxp-step--now .oxp-step__n { font-weight: 500; }
  .oxp-di { grid-column: 1 / -1; margin: 0; max-width: 900px; font-family: var(--display); font-size: 34px; line-height: 1.3; letter-spacing: -0.02em; color: var(--green); }
  .oxp-di strong { font-weight: 400; background: linear-gradient(transparent 62%, var(--lime) 62%); }

  /* Main card: dark, the expertise itself. */
  .oxp-main { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 24px; align-items: end; min-height: 220px; padding: 36px; border-radius: 20px; background: var(--green); color: var(--white); text-decoration: none; transition: background-color .3s; }
  .oxp-main:active { color: var(--white); }
  .oxp-main:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }
  .oxp-main__title { grid-column: 1 / -1; align-self: start; margin: 0; font-weight: 400; font-family: var(--display); font-size: 40px; line-height: 1.08; letter-spacing: -0.03em; }
  .oxp-main__text { font-size: 18px; font-weight: 300; line-height: 1.45; color: var(--on-dark-muted); }
  .oxp-main__page { font-weight: 500; color: var(--white); }
  .oxp-main .oxp-go { border-color: var(--lime); color: var(--lime); }
  .oxp-main:focus-visible .oxp-go { background: var(--lime); color: var(--green); }

  /* Embedded disciplines: lighter rows. */
  .oxp__list { display: flex; flex-direction: column; gap: 10px; margin: 0; padding: 0; list-style: none; }
  /* Hover stays quiet (white with a green ring); lime is kept for the arrow only. */
  .oxp-link { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 24px; align-items: center; padding: 20px 24px; border-radius: 16px; background: var(--grey); color: var(--green); text-decoration: none; transition: background-color .3s, box-shadow .3s; }
  .oxp-link:active { color: var(--green); background: var(--white); box-shadow: inset 0 0 0 1px var(--green); }
  .oxp-link:focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }
  .oxp-link__title { font-family: var(--display); font-size: 24px; line-height: 1.15; letter-spacing: -0.02em; }
  .oxp-link__text { grid-column: 1; font-size: 16px; font-weight: 300; line-height: 1.45; color: var(--text-soft); }
  .oxp-link .oxp-go { grid-row: 1 / span 2; width: 44px; height: 44px; }
  .oxp-link:focus-visible .oxp-go { background: var(--green); color: var(--lime); }

  .oxp-go { grid-column: 2; display: grid; place-items: center; width: 52px; height: 52px; border: 1px solid var(--green); border-radius: 50%; transition: background-color .3s, color .3s; }
  .oxp-go :global(svg) { transition: transform .3s cubic-bezier(.16, 1, .3, 1); }
  :is(.oxp-main, .oxp-link):focus-visible .oxp-go :global(svg) { transform: translateX(3px); }
  /* Hover only where a pointer can hover, so a tap on a phone doesn't leave cards stuck in their hover look. */
  @media (hover: hover) {
    .oxp-nav a:hover { background: var(--green); color: var(--white); }
    .oxp-nav a:hover svg { transform: translateY(2px); }
    .oxp-main:hover { color: var(--white); background: color-mix(in srgb, var(--green) 88%, var(--white)); }
    .oxp-main:hover .oxp-go { background: var(--lime); color: var(--green); }
    .oxp-link:hover { color: var(--green); background: var(--white); box-shadow: inset 0 0 0 1px var(--green); }
    .oxp-link:hover .oxp-go { background: var(--green); color: var(--lime); }
    :is(.oxp-main, .oxp-link):hover .oxp-go :global(svg) { transform: translateX(3px); }
  }

  .oxp-cta { padding-top: 110px; padding-bottom: 40px; }
  /* The ending gets the page's accent: lime on --green (13.6:1), so it doesn't read as a third main card. */
  .oxp-cta__hl { color: var(--lime); }

  @media (max-width: 1024px) {
    .oxp-lead { font-size: 24px; }
    .oxp__inner { grid-template-columns: 1fr; }
    .oxp__head { position: static; }
    .oxp__head h2 { font-size: 40px; }
    .oxp-main__title { font-size: 32px; }
    .oxp-di { font-size: 28px; }
  }
  @media (max-width: 767px) {
    .oxp-title { margin-bottom: 20px; }
    .oxp-lead { margin-bottom: 30px; font-size: 18px; }
    .oxp-nav a { font-size: 16px; }
    .oxp { padding: 50px 16px 0; }
    .oxp--story { padding-top: 0; }
    .oxp__head h2 { font-size: 34px; }
    .oxp__head p:last-child { font-size: 17px; }
    .oxp-step { padding: 20px 0; gap: 4px 14px; }
    .oxp-step h3 { font-size: 22px; }
    .oxp-step p { font-size: 16px; }
    .oxp-di { font-size: 22px; }
    .oxp-main { min-height: 0; padding: 24px 22px; }
    .oxp-main__title { font-size: 26px; }
    .oxp-main__text { font-size: 16px; }
    .oxp-link { padding: 18px 18px; gap: 4px 14px; }
    .oxp-link__title { font-size: 20px; }
    .oxp-go, .oxp-link .oxp-go { width: 40px; height: 40px; }
    .oxp-cta { padding-top: 70px; }
  }
  @media (prefers-reduced-motion: reduce) { .oxp-go :global(svg), .oxp-nav svg { transition: none; } }
</style>
