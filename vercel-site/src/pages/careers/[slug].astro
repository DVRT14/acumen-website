---
// Vacancies (old site pages 4122 / 4165, one layout). Content: src/content/vacatures/*.json.
// The application form posts to the forms stub like every site form.
import Base from '../../layouts/Base.astro';
import '../../styles/vacature.css';

export function getStaticPaths() {
  const pages = import.meta.glob('../../content/vacatures/*.json', { eager: true, import: 'default' });
  return Object.entries(pages).map(([file, page]) => ({
    params: { slug: file.split('/').pop().replace(/\.json$/, '') },
    props: { page },
  }));
}
const { page } = Astro.props;
const arrow = '<svg xmlns="http://www.w3.org/2000/svg" width="46.819" height="46.819" viewBox="0 0 46.819 46.819" aria-hidden="true"><path d="M5.838,24.92l19.7,19.7-2.127,2.2L0,23.409,23.409,0l2.128,2.2L5.838,21.9H46.819V24.92Z" transform="translate(46.819 46.819) rotate(180)"></path></svg>';
const fields = [
  { id: 'vac-first-name', name: 'form_fields[field_60ffdb1]', type: 'text', label: 'Voornaam', placeholder: 'Voornaam' },
  { id: 'vac-last-name', name: 'form_fields[field_2d10064]', type: 'text', label: 'Achternaam', placeholder: 'Achternaam' },
  { id: 'vac-email', name: 'form_fields[email]', type: 'email', label: 'Email', placeholder: 'E-mail' },
];
---
<Base seo={page.seo}>
  <div class="vac">
    <section class="vac__sec">
      <div class="vac__inner">
        <h1 class="vac__title" set:html={page.title} />
        <div class="vac__location" set:html={page.location} />
        <div class="vac__space vac__space--50"></div>
      </div>
    </section>

    <section class="vac__sec">
      <div class="vac__inner">
        <h2 class="vac__heading" set:html={page.aboutTitle} />
        <div class="vac__space vac__space--20"></div>
        <div class="vac__text" set:html={page.aboutText} />
        <div class="vac__space vac__space--50"></div>
        <h2 class="vac__heading" set:html={page.roleTitle} />
        <div class="vac__space vac__space--20"></div>
        <div class="vac__text" set:html={page.roleText} />
        <div class="vac__space vac__space--50"></div>
        {[page.cards.slice(0, 2), page.cards.slice(2)].map((pair, i) => (
          <Fragment>
            {i > 0 && <div class="vac__space vac__space--20"></div>}
            <div class="vac__grid">
              {pair.map(c => (
                <div class="vac__card">
                  <h2 class="vac__card-title" set:html={c.title} />
                  <div class="vac__space vac__space--20"></div>
                  <div class="vac__card-text" set:html={c.text} />
                </div>
              ))}
            </div>
          </Fragment>
        ))}
      </div>
    </section>

    <section class="vac__sec">
      <div class="vac__inner">
        <div class="vac__space vac__space--50 vac__space--m14"></div>
        <h2 class="vac__heading" set:html={page.whyTitle} />
        <div class="vac__space vac__space--20"></div>
        <div class="vac__text" set:html={page.whyText} />
        <div class="vac__space vac__space--50"></div>
        <div class="vac__text" set:html={page.applyText} />
        <div class="vac__space vac__space--50 vac__space--m14"></div>
        <h2 class="vac__heading" set:html={page.applyTitle} />
        <div class="vac__apply">
          <div class="vac__space vac__space--13"></div>
          <form class="vac-form" method="post" name={page.form.name} enctype="multipart/form-data" data-form>
            <input type="hidden" name="post_id" value={page.form.post_id} />
            <input type="hidden" name="form_id" value={page.form.form_id} />
            <input type="hidden" name="referer_title" value={page.form.referer_title} />
            <input type="hidden" name="queried_id" value={page.form.queried_id} />
            <div class="vac-form__fields">
              {fields.map(f => (
                <div class="vac-form__group vac-form__group--66 form-field">
                  <label for={f.id} class="visually-hidden">{f.label}</label>
                  <input size="1" type={f.type} name={f.name} id={f.id} class="vac-form__input" placeholder={f.placeholder} required />
                </div>
              ))}
              <div class="vac-form__group form-field">
                <label for="vac-cv" class="visually-hidden">CV</label>
                <input type="file" name="form_fields[field_bdfd5ff][]" id="vac-cv" class="vac-form__file" required multiple />
              </div>
              <div class="vac-form__group vac-form__group--33 vac-form__group--submit form-field">
                <button class="vac-form__button" type="submit">
                  <span class="vac-form__button-content"><span class="vac-form__button-icon" set:html={arrow} /><span>Solliciteer</span></span>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</Base>
