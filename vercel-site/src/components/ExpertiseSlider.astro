---
// "Our Expertise" slider (was listing 2137 in a slick carousel). widgets.js initialises Swiper.
import 'swiper/css';
import 'swiper/css/a11y';
import ExpertiseCard from './ExpertiseCard.astro';
import cards from '../data/expertise-cards.json';
---
<div class="xslider animated-fast" data-animate="fadeIn" data-animate-delay="500">
  <div class="swiper xslider__swiper">
    <div class="swiper-wrapper">
      {cards.map(card => <div class="swiper-slide xslider__item" role="group" aria-roledescription="slide"><ExpertiseCard card={card} /></div>)}
    </div>
  </div>
  <div class="carousel-dots xslider__dots"></div>
</div>
