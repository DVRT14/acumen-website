---
// Legacy pages: the exported WordPress HTML, split into head / body so shared components can
// replace their Elementor markup one at a time. Pages move out of here as they are rebuilt.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { parseLegacy, cutDiv, dropStyles } from '../lib/legacy.js';

export function getStaticPaths() {
  const files = import.meta.glob('../legacy/*.html', { query: '?raw', import: 'default', eager: true });
  // Pages that have been rebuilt as real Astro pages are served by those instead.
  const rebuilt = Object.keys(import.meta.glob('../content/knowledge/*.json')).map(f => 'knowledge~' + f.split('/').pop().replace(/\.json$/, ''));
  return Object.entries(files).filter(([file]) => !rebuilt.includes(file.split('/').pop().replace(/\.html$/, ''))).map(([file, html]) => {
    const name = file.split('/').pop().replace(/\.html$/, '');
    return { params: { slug: name === 'index' ? undefined : name.replaceAll('~', '/') }, props: { html } };
  });
}
const route = Astro.url.pathname;
let { head, bodyAttrs, body } = parseLegacy(Astro.props.html);
body = cutDiv(body, 'data-elementor-type="header"').html;
body = cutDiv(body, 'data-elementor-type="footer"').html;
head = dropStyles(head, ['elementor-post-48-css', 'elementor-post-3137-css', 'elementor-post-804-css']);
---
<!doctype html>
<html lang="nl-BE">
<head>
<Fragment set:html={head} />
<link rel="stylesheet" href="/css/consent.css" />
</head>
<body {...bodyAttrs}>
<Header current={route} home={route === '/'} />
<Fragment set:html={body} />
<Footer current={route} home={route === '/'} />
<ConsentBanner />
<script src="../scripts/site.js"></script>
</body>
</html>
