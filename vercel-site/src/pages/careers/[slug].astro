---
// Vacancies (old site pages 4122 / 4165), on the case-page system (case.css + tokens in base.css).
// Content: src/content/vacatures/*.json (Dutch). The application form posts to the forms webhook like every
// site form; field names and hidden fields are unchanged so submissions stay identifiable.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/knowledge/Breadcrumbs.astro';
import '../../styles/case.css';
import '../../styles/vacature.css';

export function getStaticPaths() {
  const pages = import.meta.glob('../../content/vacatures/*.json', { eager: true, import: 'default' });
  return Object.entries(pages).map(([file, page]) => ({
    params: { slug: file.split('/').pop().replace(/\.json$/, '') },
    props: { page },
  }));
}
const { page } = Astro.props;
const text = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/&#8211;/g, '–').replace(/\s+/g, ' ').trim();
// WordPress left empty spacer paragraphs (<p>&nbsp;</p>) between blocks: drop them, spacing comes from CSS.
const clean = (html: string) => html.replace(/<p>(\s|&nbsp;)*<\/p>/g, '');
const title = text(page.title);
const location = text(page.location);
// JobPosting (Google Jobs), from the JSON only. No employmentType (the texts don't state it), no jobLocationType
// (TELECOMMUTE means fully remote; these roles are hybrid), no validThrough/baseSalary (not in the data).
// Description: the page's own sections, with Word-paste <span>s and attributes stripped (Google allows p/ul/li/strong/h*).
const bare = (html: string) => clean(html).replace(/<\/?span[^>]*>/g, '').replace(/<([a-z0-9]+)\s[^>]*>/gi, '<$1>');
const site = Astro.site!.origin;
const jobPosting = {
  '@type': 'JobPosting', '@id': `${site}${Astro.url.pathname}#job`, url: `${site}${Astro.url.pathname}`,
  title, inLanguage: 'nl-BE', datePosted: page.seo.published, directApply: true,
  description: [
    `<h2>${text(page.aboutTitle)}</h2>`, bare(page.aboutText), `<h2>${text(page.roleTitle)}</h2>`, bare(page.roleText),
    ...page.cards.map((c: { title: string; text: string }) => `<h3>${text(c.title).replace(/:$/, '')}</h3>${bare(c.text)}`),
    `<h2>${text(page.whyTitle)}</h2>`, bare(page.whyText),
  ].join(''),
  hiringOrganization: { '@type': 'Organization', '@id': `${site}/#organization`, name: 'Acumen', sameAs: 'https://acumen.be' },
  jobLocation: { '@type': 'Place', address: { '@type': 'PostalAddress', streetAddress: 'Ambachtenlaan 14/8', postalCode: '3001', addressLocality: 'Leuven', addressCountry: 'BE' } },
};
const fields = [
  { id: 'vac-first-name', name: 'form_fields[field_60ffdb1]', type: 'text', label: 'Voornaam', autocomplete: 'given-name' },
  { id: 'vac-last-name', name: 'form_fields[field_2d10064]', type: 'text', label: 'Achternaam', autocomplete: 'family-name' },
  { id: 'vac-email', name: 'form_fields[email]', type: 'email', label: 'E-mail', autocomplete: 'email' },
];
---
<Base seo={page.seo} schema={[jobPosting]}>
  <article class="case vac">
    <header class="case-wrap vac-hero">
      <Breadcrumbs label="Kruimelpad" items={[{ name: 'Home', href: '/' }, { name: 'Careers', href: '/culture/#careers' }, { name: title }]} />
      <p class="case-label">Vacature<span aria-hidden="true"> · </span>{location}</p>
      <h1 class="case-hero__title">{title}</h1>
      <p class="case-hero__lead">{page.seo.description.replace(/^Vacature [^:]+:\s*/, '').replace(/^./, (ch: string) => ch.toUpperCase())}</p>
      <div class="vac-actions">
        <a class="btn" href="#solliciteer">Solliciteer</a>
        <a class="btn btn--outline" href="/culture/">Onze cultuur</a>
      </div>
    </header>

    <div class="case-wrap case-main vac-main">
      <aside class="case-facts vac-facts" aria-label="Over deze vacature">
        <dl class="case-facts__list">
          <div><dt>Functie</dt><dd>{title}</dd></div>
          <div><dt>Locatie</dt><dd>{location}</dd></div>
          <div><dt>Solliciteren</dt><dd>Je CV en contactgegevens, via het formulier onderaan.</dd></div>
        </dl>
        <a class="btn vac-facts__cta" href="#solliciteer">Solliciteer</a>
      </aside>

      <div class="case-content">
        <div class="case-prose vac-prose">
          <h2>{text(page.aboutTitle)}</h2>
          <Fragment set:html={clean(page.aboutText)} />
          <h2>{text(page.roleTitle)}</h2>
          <Fragment set:html={clean(page.roleText)} />
        </div>

        <div class="vac-lists">
          {page.cards.map((card: { title: string; text: string }) => (
            <section class="vac-list" aria-label={text(card.title).replace(/:$/, '')}>
              <h3>{text(card.title).replace(/:$/, '')}</h3>
              <div class="vac-list__body" set:html={clean(card.text)} />
            </section>
          ))}
        </div>

        <div class="case-prose vac-prose">
          <h2>{text(page.whyTitle)}</h2>
          <Fragment set:html={clean(page.whyText)} />
        </div>
      </div>
    </div>

    <section class="case-wrap vac-apply" id="solliciteer" aria-labelledby="vac-apply-title">
      <div class="vac-apply__card">
        <div class="vac-apply__intro">
          <h2 id="vac-apply-title">{text(page.applyTitle).replace(/!$/, '')}</h2>
          <p>{text(page.applyText)}</p>
        </div>
        <form class="vac-form" method="post" name={page.form.name} enctype="multipart/form-data" data-form data-success="Bedankt voor je sollicitatie. We nemen zo snel mogelijk contact met je op.">
          <input type="hidden" name="post_id" value={page.form.post_id} />
          <input type="hidden" name="form_id" value={page.form.form_id} />
          <input type="hidden" name="referer_title" value={page.form.referer_title} />
          <input type="hidden" name="queried_id" value={page.form.queried_id} />
          <div class="vac-form__grid">
            {fields.map(f => (
              <div class={`vac-form__field form-field${f.type === 'email' ? ' vac-form__field--wide' : ''}`}>
                <label for={f.id}>{f.label}</label>
                <input type={f.type} name={f.name} id={f.id} autocomplete={f.autocomplete} required />
              </div>
            ))}
            <div class="vac-form__field vac-form__field--wide form-field">
              <span class="vac-form__label" id="vac-cv-label">CV</span>
              <label class="vac-file" for="vac-cv">
                <input type="file" name="form_fields[field_bdfd5ff][]" id="vac-cv" aria-labelledby="vac-cv-label" required multiple />
                <span class="vac-file__button">Kies bestand</span>
                <span class="vac-file__hint">PDF of Word, max. 4 MB</span>
              </label>
            </div>
          </div>
          <button class="btn btn--on-dark vac-form__submit" type="submit">Verstuur sollicitatie</button>
        </form>
      </div>
    </section>
  </article>
</Base>
