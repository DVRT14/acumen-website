---
// Legacy pages: the exported WordPress HTML, rendered verbatim apart from the shared runtime
// injected before </body>. Replaced template by template.
import ConsentBanner from '../components/ConsentBanner.astro';

export function getStaticPaths() {
  const files = import.meta.glob('../legacy/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.entries(files).map(([file, html]) => {
    const name = file.split('/').pop().replace(/\.html$/, '');
    return { params: { slug: name === 'index' ? undefined : name.replaceAll('~', '/') }, props: { html } };
  });
}
const { html } = Astro.props;
const end = html.lastIndexOf('</body>');
---
<Fragment set:html={html.slice(0, end)} />
<link rel="stylesheet" href="/css/consent.css" />
<ConsentBanner />
<script src="../scripts/site.js"></script>
<Fragment set:html={html.slice(end)} />
