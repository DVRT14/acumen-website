---
// Our Expertise: the overview that routes to the /expertise/* pages. Decision intelligence rests on two expertises:
// Data Science & AI (the house) on Data Engineering (the foundation). A short "why pilots stall" section defines
// decision intelligence once; then one stack, top (visible) to bottom, whose layers are the links to the detail pages.
// The stack widens downward: the foundation is the broadest part.
import Base from '../layouts/Base.astro';
import meta from '../data/meta.json';
import '../styles/post.css';
import '../styles/case.css';
const m = meta['our-expertise'];

const arrow = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';

// The stack, top to bottom. Each layer is one detail page; `page` names it, since the layer title says what it does.
// Data Strategy leads the house: it is where someone with a working pilot starts. `ai` marks the lime layer (the AI people see).
const groups = [
  {
    id: 'data-science-ai', role: 'The house.', title: 'Data Science & AI',
    text: 'AI at work in operational and financial decisions: predicting no-shows, planning routes, forecasting demand and cash flow, scheduling staff.',
    layers: [
      { href: '/expertise/data-strategy/', title: 'Which decisions to automate first', page: 'Data Strategy' },
      { href: '/expertise/datascience-ai/', title: 'AI in your processes', page: 'Data Science & AI', ai: true },
      { href: '/expertise/data-planning-epm/', title: 'Plans, budgets and forecasts', page: 'Data Planning & EPM' },
    ],
  },
  {
    id: 'data-engineering', role: 'The foundation.', title: 'Data Engineering',
    text: 'Definitions, tests, ownership and lineage live in the code next to the data, so every answer can be checked. Standard stack: dbt, Databricks or Microsoft Fabric, Dagster.',
    layers: [
      { href: '/expertise/datavisualisation-reporting/', title: 'Reports and dashboards', page: 'Data Visualization & Reporting' },
      { href: '/expertise/dataintegration-engineering/', title: 'One platform for all your data', page: 'Data Integration & Engineering' },
      { href: '/expertise/data-governance/', title: 'Definitions, quality and ownership', page: 'Data Governance' },
      { href: '/expertise/support-maintenance/', title: 'Kept reliable as your business changes', page: 'Support & Maintenance' },
    ],
  },
];
// Step-in per layer, counted from the bottom across both groups, so the last foundation layer is full width.
let n = groups.reduce((sum, g) => sum + g.layers.length, 0);
const stack = groups.map(g => ({ ...g, layers: g.layers.map(l => ({ ...l, d: --n })) }));
---
<Base {...m}>
  <section class="post-sec post-hero">
    <div class="post-sec__inner post-hero__inner oxp-hero">
      <div class="oxp-hero__text">
        <div class="post-hero__title oxp-title"><h1>Our expertise</h1></div>
        <p class="oxp-lead">Your first AI experiment works. Now make it work on the decisions that matter.</p>
        <p class="oxp-intro">Building an AI tool is quick. Putting AI to work on your organisation’s data, in the decisions made every day, takes more. That is what we do, from the data foundation to AI inside your processes.</p>
        <nav class="oxp-nav" aria-label="Expertises">
          {groups.map(g => <a href={`#${g.id}`}>{g.title}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6" /></svg></a>)}
        </nav>
      </div>
      <!-- sizes: the 4:5 slot crops a 3:2 photo by height, so desktop needs ~1.9x the column width (about 61vw). -->
      <div class="oxp-hero__media"><img src="/wp-content/uploads/2025/07/DSCF1140-1200x800.webp" srcset="/wp-content/uploads/2025/07/DSCF1140-800x533.webp 800w, /wp-content/uploads/2025/07/DSCF1140-1200x800.webp 1200w, /wp-content/uploads/2025/07/DSCF1140-1600x1067.webp 1600w" sizes="(max-width: 1024px) calc(100vw - 32px), 61vw" width="1200" height="800" alt="Acumen consultants going through data together on a screen" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="oxp oxp--story" aria-labelledby="oxp-story-title">
    <div class="oxp__inner oxp__inner--story">
      <h2 class="oxp__h2" id="oxp-story-title">Why pilots stall</h2>
      <p class="oxp-story">A pilot runs on a clean sample. In production, AI meets your real data, and that data has to carry its context: what each number means, where it comes from and who owns it. A report can stay wrong for years; a model built on the wrong meaning fails within weeks.</p>
      <p class="oxp-di"><strong>The fix is decision intelligence.</strong> Routine decisions run on data automatically, and your experts own the exceptions, where their knowledge matters most. We build it in that order: the foundation first, then the house on top.</p>
    </div>
  </section>

  <section class="oxp" aria-labelledby="oxs-title">
    <div class="oxp__inner">
      <header class="oxp__head">
        <h2 class="oxp__h2" id="oxs-title">AI is the part you see</h2>
        <p>It stands on a foundation you don’t. An AI answer is only as good as the data and the choices underneath it, so one team builds every floor.</p>
      </header>
      <div class="oxs">
        {stack.map(g => (
          <div class="oxs-group" id={g.id}>
            <h3 class="oxs-title"><strong>{g.role}</strong> {g.title}</h3>
            <p class="oxs-text">{g.text}</p>
            <ul class="oxs-layers">
              {g.layers.map(l => (
                <li style={`--d:${l.d}`}>
                  <a class:list={['oxs-layer', { 'oxs-layer--ai': l.ai, 'oxs-layer--house': g.id === 'data-science-ai' }]} href={l.href}>
                    <span class="oxs-layer__title">{l.title}</span>
                    <span class="visually-hidden">, </span>
                    <span class="oxs-layer__page">{l.page}</span>
                    <span class="oxp-go" aria-hidden="true" set:html={arrow} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="case-wrap case-cta oxp-cta" aria-labelledby="oxp-cta-title">
    <div class="case-cta__card">
      <h2 class="case-cta__title" id="oxp-cta-title">Which decision <span class="oxp-cta__hl">matters most?</span></h2>
      <p class="case-cta__text">Tell us. In a 30-minute call we map the information that decision needs, what is already in place and where to start.</p>
      <a class="case-cta__button" href="/contact/">Plan a call</a>
    </div>
  </section>
</Base>

<style>
  /* Hero: text left, photo right; the photo stacks under the text from 1024px down. */
  .oxp-hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 40px 60px; align-items: center; }
  .oxp-hero__media img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 40% 50%; border-radius: 20px; }
  .oxp-title { margin-bottom: 30px; }
  .oxp-lead { margin: 0 0 16px; max-width: 800px; font-family: var(--display); font-size: 30px; line-height: 1.35; color: var(--green); }
  .oxp-intro { margin: 0 0 32px; max-width: 760px; font-size: 20px; font-weight: 300; line-height: 1.45; color: var(--text-soft); }
  /* Jump links: outlined pills with a down arrow, so they read as "go to section". */
  .oxp-nav { display: flex; flex-wrap: wrap; gap: 10px; }
  .oxp-nav a { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 8px 18px 8px 22px; border: 1px solid var(--green); border-radius: 200px; font-size: 17px; line-height: 1.2; color: var(--green); text-decoration: none; transition: background-color .25s, color .25s; }
  .oxp-nav a:focus-visible { background: var(--green); color: var(--white); }
  .oxp-nav svg { transition: transform .3s cubic-bezier(.16, 1, .3, 1); }

  /* One section: intro left (sticky on desktop), content right. scroll-margin clears the fixed header (96px). */
  .oxp { padding: 70px 50px 0; }
  .oxp--story { padding-top: 10px; }
  .oxp__inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 30px 60px; max-width: 1180px; margin: 0 auto; padding-top: 30px; border-top: 1px solid var(--line); }
  .oxp__head { align-self: start; position: sticky; top: 120px; }
  .oxp__h2 { margin: 0 0 20px; font-family: var(--display); font-size: 56px; font-weight: 400; line-height: 1.05; letter-spacing: -0.04em; color: var(--green); text-wrap: balance; }
  .oxp__head p { margin: 0; max-width: 46ch; font-size: 20px; font-weight: 300; line-height: 1.45; color: var(--text-soft); }

  /* Story: heading left, the reason right, then the decision intelligence line across the full width. */
  .oxp__inner--story { row-gap: 40px; }
  .oxp-story { margin: 0; max-width: 60ch; font-size: 20px; font-weight: 300; line-height: 1.5; color: var(--text-soft); }
  .oxp-di { grid-column: 1 / -1; margin: 0; max-width: 900px; font-family: var(--display); font-size: 34px; line-height: 1.3; letter-spacing: -0.02em; color: var(--green); }
  :is(.oxp-di, .oxs-title) strong { font-weight: 400; background: linear-gradient(transparent 62%, var(--lime) 62%); }

  /* Stack: every layer is a link to its detail page. Layers step out as they go down, so the foundation is the widest.
     The AI layer (what people see) is lime, the rest of the house green, the foundation grey. */
  .oxs { display: flex; flex-direction: column; gap: 44px; }
  .oxs-group { scroll-margin-top: 110px; }
  .oxs-title { margin: 0 0 8px; font-family: var(--display); font-size: 30px; font-weight: 400; line-height: 1.15; letter-spacing: -0.02em; color: var(--green); text-wrap: balance; }
  .oxs-text { margin: 0 0 18px; max-width: 58ch; font-size: 17px; font-weight: 300; line-height: 1.45; color: var(--text-soft); }
  .oxs-layers { display: flex; flex-direction: column; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .oxs-layers li { margin-left: calc(var(--d) * 16px); }
  .oxs-layer { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 20px; align-items: center; padding: 14px 16px 14px 22px; border-radius: 12px; background: var(--grey); color: var(--green); text-decoration: none; transition: background-color .3s, box-shadow .3s; }
  .oxs-layer:active { color: var(--green); }
  .oxs-layer__title { font-family: var(--display); font-size: 22px; line-height: 1.2; letter-spacing: -0.02em; }
  .oxs-layer__page { grid-column: 1; font-size: 14px; line-height: 1.4; color: var(--text-soft); }
  .oxs-layer--house, .oxs-layer--house:active { background: var(--green); color: var(--white); }
  .oxs-layer--house .oxs-layer__page { color: var(--on-dark-muted); }
  .oxs-layer--ai, .oxs-layer--ai:active { background: var(--lime); color: var(--green); }
  .oxs-layer--ai .oxs-layer__page { color: var(--green); }

  .oxp-go { grid-column: 2; grid-row: 1 / span 2; display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid currentColor; border-radius: 50%; transition: background-color .3s, color .3s, border-color .3s; }
  .oxs-layer--house:not(.oxs-layer--ai) .oxp-go { border-color: var(--lime); color: var(--lime); }
  .oxp-go :global(svg) { transition: transform .3s cubic-bezier(.16, 1, .3, 1); }
  .oxs-layer:focus-visible .oxp-go :global(svg) { transform: translateX(3px); }
  /* Hover only where a pointer can hover, so a tap on a phone doesn't leave layers stuck in their hover look. */
  @media (hover: hover) {
    .oxp-nav a:hover { background: var(--green); color: var(--white); }
    .oxp-nav a:hover svg { transform: translateY(2px); }
    .oxs-layer:hover { color: var(--green); background: var(--white); box-shadow: inset 0 0 0 1px var(--green); }
    .oxs-layer--house:hover { color: var(--white); background: color-mix(in srgb, var(--green) 88%, var(--white)); box-shadow: none; }
    .oxs-layer--ai:hover { color: var(--green); background: var(--lime); box-shadow: inset 0 0 0 1px var(--green); }
    .oxs-layer:hover .oxp-go { background: var(--green); border-color: var(--green); color: var(--lime); }
    .oxs-layer--house:not(.oxs-layer--ai):hover .oxp-go { background: var(--lime); color: var(--green); }
    .oxs-layer:hover .oxp-go :global(svg) { transform: translateX(3px); }
  }

  .oxp-cta { padding-top: 110px; padding-bottom: 40px; }
  /* The ending gets the page's accent: lime on --green (13.6:1). */
  .oxp-cta__hl { color: var(--lime); }

  @media (max-width: 1024px) {
    .oxp-hero { grid-template-columns: minmax(0, 1fr); }
    .oxp-hero__media img { aspect-ratio: 3 / 2; max-height: 420px; }
    .oxp-lead { font-size: 26px; }
    .oxp__inner { grid-template-columns: 1fr; }
    .oxp__head { position: static; }
    .oxp__h2 { font-size: 40px; }
    .oxp-di { font-size: 28px; }
  }
  @media (max-width: 767px) {
    .oxp-title { margin-bottom: 20px; }
    .oxp-lead { font-size: 22px; }
    .oxp-intro { margin-bottom: 30px; font-size: 16px; }
    .oxp-nav a { font-size: 16px; }
    .oxp { padding: 50px 16px 0; }
    .oxp--story { padding-top: 0; }
    .oxp__h2 { margin-bottom: 14px; font-size: 34px; }
    .oxp__inner--story .oxp__h2 { margin-bottom: 0; } /* the grid row-gap spaces it here */
    .oxp__inner--story { row-gap: 20px; }
    :is(.oxp__head p, .oxp-story) { font-size: 16px; }
    .oxp-di { font-size: 22px; }
    .oxs { gap: 36px; }
    .oxs-title { font-size: 24px; }
    .oxs-text { font-size: 16px; }
    .oxs-layers li { margin-left: calc(var(--d) * 6px); }
    .oxs-layer { padding: 12px 12px 12px 16px; gap: 2px 12px; }
    .oxs-layer__title { font-size: 18px; }
    .oxp-go { width: 40px; height: 40px; }
    .oxp-cta { padding-top: 70px; }
  }
  @media (prefers-reduced-motion: reduce) { .oxp-go :global(svg), .oxp-nav svg { transition: none; } }
</style>
